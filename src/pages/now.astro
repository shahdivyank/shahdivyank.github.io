---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/site/TopBar.astro";
import SectionNav from "../components/site/SectionNav.astro";
import Masthead from "../components/site/Masthead.astro";
import HairlineSection from "../components/site/HairlineSection.astro";
import InfoPanel from "../components/site/InfoPanel.astro";
import Footer from "../components/site/Footer.astro";
---
<Layout title="Now — Divyank Shah">
  <TopBar showName />
  <Masthead word="NOW" label="CURRENT" />
  <SectionNav active="Now" />
  <main>
    <HairlineSection>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <InfoPanel title="Now" rows={[{label:"Building", value:"[Project]"}, {label:"Learning", value:"[Topic]"}, {label:"Reading", value:"[Book]"}]} />
        <InfoPanel title="Experiments" rows={[{label:"Trying", value:"[Thing]"}, {label:"Next", value:"[Thing]"}]} />
      </div>
    </HairlineSection>
  </main>
  <Footer />
</Layout>