---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/site/TopBar.astro";
import SectionNav from "../components/site/SectionNav.astro";
import Masthead from "../components/site/Masthead.astro";
import HairlineSection from "../components/site/HairlineSection.astro";
import SectionHeadingRow from "../components/site/SectionHeadingRow.astro";
import Reveal from "../components/site/Reveal.astro";
import Footer from "../components/site/Footer.astro";
---
<Layout title="Research — Divyank Shah" description="Continual federated learning and LiDAR-camera calibration.">
  <TopBar showName />
  <Masthead word="RESEARCH" label="LAB + PAPERS" />
  <SectionNav active="Research" />
  <main>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Research" copy="Continual federated active learning for 3D detection + LiDAR-camera calibration." ctaLabel="Lab" ctaHref="https://cisl.ucr.edu" /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        <Reveal><article class="hairline p-6"><div class="flex items-center gap-3"><div class="keep-round flex aspect-square h-16 w-16 items-center justify-center overflow-hidden border border-line bg-white"><img src="/images/logos/ucr-logo.webp" alt="UC Riverside" class="keep-round h-full w-full object-cover" loading="lazy" /></div></div><p class="mt-4 text-xs uppercase tracking-wide text-ink-muted">Graduate Researcher · Oct 2024 – Jan 2026</p><h3 class="mt-2 text-lg font-medium">Collaborative Intelligence Systems Lab — Dr. Hang Qiu</h3><p class="text-sm text-ink-muted">Riverside, CA</p><ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink-muted"><li>Benchmarked FCOS3D in continual federated active env (Flower.ai + MMDetection3D, uniform/entropy/confidence/margin/coreset/CALD sampling)</li><li>Collected multi-agent CARLA interactions for multi-agent learning</li><li>Rebuilt Command Input Imitation Learning pipeline with custom CARLA image + position data in PyTorch</li><li>Created 150+ static/dynamic camera/LiDAR snapshots for targetless calibration</li><li>Benchmarked CalibNet on KITTI, NuScenes, CalibDB as baseline for BevCalib</li></ul></article></Reveal>
        <Reveal delay={0.08}>
          <article class="flex h-full flex-col justify-between bg-ink p-6 text-on-ink">
            <div><p class="text-xs uppercase tracking-wide opacity-70">Publication</p><h3 class="mt-2 text-xl font-medium leading-snug">BEVCALIB: LiDAR-Camera Calibration via Geometry-Guided Bird's-Eye View Representations</h3><p class="mt-2 text-sm opacity-80">Weiduo Yuan, Jerry Li, Justin Yue, <strong>Divyank Shah</strong>, Konstantinos Karydis, Hang Qiu</p><p class="mt-3 text-xs uppercase tracking-wide opacity-70">9th Conference on Robot Learning (CoRL 2025), Seoul, Korea</p></div>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="https://arxiv.org/pdf/2506.02587" class="btn-secondary border-on-ink/40! text-on-ink!">Read paper ↗</a>
              <a href="https://scholar.google.com/citations?user=QP01IqkAAAAJ&hl=en" class="btn-secondary border-on-ink/40! text-on-ink!">Google Scholar ↗</a>
            </div>
          </article>
        </Reveal>
        <Reveal delay={0.16}>
          <article class="hairline flex h-full flex-col justify-between p-6 md:col-span-2">
            <div>
              <span class="hairline inline-block px-2 py-1 text-[0.6875rem] uppercase tracking-widest">Acknowledgement</span>
              <h3 class="mt-4 text-lg font-medium leading-snug text-ink">CooperScene: Multi-Modal Cooperative Autonomy Benchmark with C-V2X Communication Characterization</h3>
              <p class="mt-2 text-sm text-ink-muted">Bo Wu, Ruoshen Mo, Justin Yue, Yanyu Zhang, Janice Nguyen, Guoyuan Wu, Amit Roy-Chowdhury, Matthew J. Barth, Hang Qiu</p>
              <p class="mt-3 text-xs uppercase tracking-wide text-ink-muted">European Conference on Computer Vision (ECCV 2026)</p>
              <div class="dashed-panel mt-4 p-4">
                <p class="text-sm leading-relaxed text-ink-muted"><span class="mr-1 font-medium text-ink">†</span><strong class="font-medium text-ink">Divyank Shah</strong> — acknowledged for effort and participation in data collection and annotation.</p>
              </div>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="https://arxiv.org/pdf/2606.31219" class="btn-secondary">Read paper ↗</a>
              <a href="https://cisl.ucr.edu/CooperScene" class="btn-secondary">Project website ↗</a>
              <a href="https://scholar.google.com/citations?user=QP01IqkAAAAJ&hl=en" class="btn-secondary">Google Scholar ↗</a>
            </div>
          </article>
        </Reveal>
      </div>
    </HairlineSection>
  </main>
  <Footer />
</Layout>