---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/site/TopBar.astro";
import SectionNav from "../components/site/SectionNav.astro";
import Masthead from "../components/site/Masthead.astro";
import HairlineSection from "../components/site/HairlineSection.astro";
import SectionHeadingRow from "../components/site/SectionHeadingRow.astro";
import Reveal from "../components/site/Reveal.astro";
import StatsBar from "../components/site/StatsBar.astro";
import GalleryGridPattern from "../components/site/GalleryGridPattern.astro";
import LinkIcon from "../components/site/LinkIcon.astro";
import Footer from "../components/site/Footer.astro";

type AttendedProject = {
  event: string;
  project: string;
  desc: string;
  href: string;
  award?: string;
};

// Ordered newest → oldest (most recent first). Same-year tie-break: RoseHack → CitrusHack → CutieHack;
// other same-year events keep their existing relative order. CacheFlow (WeaveHacks 2) happened after Vault MCP (FeatureForm 2025).
const attendedProjects: AttendedProject[] = [
  {
    event: "WeaveHacks 2",
    project: "CacheFlow",
    desc: "Built at WeaveHacks 2 — caching / flow optimization helper. See Devpost for stack, demo, and team.",
    href: "https://devpost.com/software/cacheflow",
  },
  {
    event: "FeatureForm 2025",
    project: "Vault MCP",
    desc: "Built at FeatureForm 2025 — details coming soon.",
    href: "https://lnkd.in/p/gnMEa54m",
    award: "3rd Place",
  },
  {
    event: "HackTech 2024",
    project: "CodeNotes",
    desc: "Built at HackTech 2024 — notes for code, demos, and snippets. See Devpost for stack, demo, and team.",
    href: "https://devpost.com/software/codenotes",
  },
  {
    event: "TreeHacks 2024",
    project: "GitFlow",
    desc: "Built at TreeHacks 2024 — Git workflow visualizer / helper. See Devpost for stack, demo, and team.",
    href: "https://devpost.com/software/gitflow",
  },
  {
    event: "CalHacks 10.0",
    project: "Speech Master",
    desc: "Built at CalHacks 10.0 — speech practice and feedback tool. See Devpost for stack, demo, and team.",
    href: "https://devpost.com/software/speech-master",
    award: "2nd Place",
  },
  {
    event: "CitrusHack 2023",
    project: "US in R Land",
    desc: "Built at CitrusHack 2023 — playful data / AR experiment. See Devpost for stack, demo, and team.",
    href: "https://devpost.com/software/us-in-r-land",
    award: "2nd Place",
  },
  {
    event: "RoseHack 2022",
    project: "Taskmaster",
    desc: "Built at RoseHack 2022 — task management helper. See Devpost for stack, demo, and team.",
    href: "https://devpost.com/software/taskmaster-pd8joz",
  },
  {
    event: "Matador Hacks 2019",
    project: "Mental Disorder Awareness",
    desc: "Built at Matador Hacks 2019 — awareness and support experience. See Devpost for stack, demo, and team.",
    href: "https://devpost.com/software/mental-disorder-awareness",
  },
