// Small per-section galleries — drop in a photo by adding `src` / `alt` to an item.
const organizedGallery = [
  {
    title: "ROSEHACK 2023",
    src: "/images/hackathons/organized/rosehack-2.jpg",
    alt: "RoseHack 2023 organizing team posing in front of a balloon arch and handmade Rose Hack arcade cabinet",
    width: 4032,
    height: 3024,
    ratio: "landscape",
  },
  {
    title: "ROSEHACK 2023",
    src: "/images/hackathons/organized/rosehack-0.jpg",
    alt: "Three teammates celebrating in front of a tinsel and balloon photo booth",
    width: 1536,
    height: 2048,
    ratio: "square",
  },
  {
    title: "ROSEHACK 2023",
    src: "/images/hackathons/organized/rosehack-1.jpg",
    alt: "Two participants sleeping on the floor of the venue overnight",
    width: 2049,
    height: 1536,
  },

  {
    title: "BEARHACK 2024",
    src: "/images/hackathons/organized/bearhack-0.jpg",
    alt: "BearHack organizers grouped together for a photo in a classroom",
    width: 2048,
    height: 1536,
  },
  {
    title: "DESIGNVERSE 2025",
    src: "/images/hackathons/organized/designverse-0.jpg",
    alt: "Eight DesignVerse teammates standing together inside a café with chalkboard art on the wall",
    width: 3024,
    height: 4032,
  },
  {
    title: "DESIGNVERSE 2025",
    src: "/images/hackathons/organized/designverse-1.jpg",
    alt: "DesignVerse 2025 organizing team posing together",
  },
];

const judgedGallery = [
  { title: "CUTIEHACK 2025", caption: "Add a photo — reviewing submissions with the judging team." },
  { title: "VIKINGS HACKS 2025", caption: "Add a photo — scoring sheets and judge deliberations." },
  { title: "HACKDAVIS 2026", caption: "Add a photo — announcing the winners on stage." },
];

const attendedGallery = [
  {
    title: "WEAVEHACKS 2",
    src: "/images/hackathons/attended/weavehacks.HEIC",
    alt: "CacheFlow project at WeaveHacks 2",
    caption: "CacheFlow caching / flow optimization helper.",
  },
  {
    title: "FEATUREFORM 2025",
    src: "/images/hackathons/attended/featureform.HEIC",
    alt: "Vault MCP project at FeatureForm 2025",
    caption: "Vault MCP, 3rd place.",
  },
  { title: "HACKTECH 2024", caption: "Add a photo — CodeNotes for code, demos, and snippets." },
  { title: "TREEHACKS 2024", caption: "Add a photo — GitFlow Git workflow visualizer." },
  { title: "CALHACKS 10.0", caption: "Add a photo — Speech Master, 2nd place." },
  { title: "CITRUSHACK 2023", caption: "Add a photo — US in R Land playful data / AR experiment, 2nd place." },
  { title: "ROSEHACK 2022", caption: "Add a photo — Taskmaster task management helper." },
  { title: "MATADOR HACKS 2019", caption: "Add a photo — Mental Disorder Awareness and support experience." },
  {
    title: "TURION SPACE",
    src: "/images/hackathons/attended/turion-space.HEIC",
    alt: "Turion Space project photo",
  },
];

// Hackathons / designathons running Aurora (source: ACM@UCR Aurora page — "Used in").
const auroraHackathons = [
  "CutieHack 2023",
  "CutieHack 2024",
  "CutieHack 2025",
  "CitrusHack 2025",
  "RoseHack 2024",
  "RoseHack 2025",
  "DesignVerse 2024",
  "DesignVerse 2025",
];

// Quick analytics for the HACKATHONS section — ordered to match the page sections below:
// attended → judged → organized → Aurora used in. Counts derive from the lists above.
const hackathonStats = [
  { value: String(attendedProjects.length), label: "Attended" },
  { value: String(judgedProjects.length), label: "Judged" },
  { value: String(organizedEvents.length), label: "Helped organize" },
  { value: String(auroraHackathons.length), label: "Aurora used in" },
];
---
<Layout title="Hackathons — Divyank Shah" description="Attended, judged, and organized hackathons.">
  <TopBar showName />
  <Masthead word="HACKATHONS" label="BUILD + JUDGE" />
  <SectionNav active="Hackathons" />
  <main>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Hackathons" copy="Attendee, judge, and organizer — quick numbers across the hackathons I have been part of." /></Reveal>
      <Reveal delay={0.04}>
        <StatsBar stats={hackathonStats} note="" />
      </Reveal>
    </HairlineSection>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Attended Projects" copy="What I built at each hackathon — most recent first, winners highlighted with their placement." /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {attendedProjects.map((item) => (
          <Reveal>
            <article class="hairline relative flex h-full flex-col p-6">
              <div class="flex min-h-7 items-start justify-between gap-3">
                <p class="text-xs uppercase tracking-wide text-ink-muted">{item.event}</p>
                {item.award && (
                  <p class="inline-flex w-fit shrink-0 items-center gap-1 border border-line px-2 py-1 text-xs font-medium uppercase tracking-wide">★ {item.award}</p>
                )}
              </div>
              <h3 class="mt-2 text-lg font-medium">{item.project}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.desc}</p>
              <a href={item.href} target="_blank" rel="noreferrer" class="mt-4 inline-flex items-center gap-1.5 text-sm underline">
                <LinkIcon href={item.href} class="h-4 w-4" />
                {item.href.includes("devpost.com") ? "View on Devpost ↗" : "View post ↗"}
              </a>
            </article>
          </Reveal>
        ))}
      </div>
      <Reveal delay={0.04}>
        <div class="mt-10">
          <GalleryGridPattern items={attendedGallery} />
        </div>
      </Reveal>
    </HairlineSection>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Judged Projects" copy="Events I've judged — reviewing submissions, scoring projects, and celebrating the winners." /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {judgedProjects.map((item) => (
          <Reveal>
            <article class="hairline relative flex h-full flex-col p-6">
              <p class="text-xs uppercase tracking-wide text-ink-muted">{item.role}</p>
              <h3 class="mt-2 text-lg font-medium">{item.event}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.desc}</p>
            </article>
          </Reveal>
        ))}
      </div>
      <Reveal delay={0.04}>
        <div class="mt-10">
          <GalleryGridPattern items={judgedGallery} />
        </div>
      </Reveal>
    </HairlineSection>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Organized Hackathons" copy="Events I've led as software lead — from QR check-in and Aurora to Hack Week and federated judging." /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {organizedEvents.map((item) => (
          <Reveal>
            <article class="hairline relative flex h-full flex-col p-6">
              <p class="text-xs uppercase tracking-wide text-ink-muted">{item.role}</p>
              <h3 class="mt-2 text-lg font-medium">{item.event}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.desc}</p>
            </article>
          </Reveal>
        ))}
      </div>
      <div class="mt-10">
        <GalleryGridPattern items={organizedGallery} />
      </div>
    </HairlineSection>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Aurora / Minerva" copy="Things I introduced at one hackathon that are now used across UCR hackathons." /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        <Reveal delay={0.06}><article class="hairline p-6"><h3 class="font-medium">What I introduced</h3><ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted"><li>QR check-in (Rosehack 2023) · Hack Week (Rosehack 2024)</li><li>Federated judging (Rosehack 2024) · GCal schedule (Cutiehack 2023)</li><li>Aurora + Discord bot + slides templates (Cutiehack 2023)</li></ul></article></Reveal>
      </div>
    </HairlineSection>
  </main>
  <Footer />
</Layout>
