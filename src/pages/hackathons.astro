// Ordered oldest → newest. Same-year tie-break: RoseHack → CitrusHack → CutieHack;
// other same-year events keep their existing relative order.
const organizedEvents = [
  {
    event: "RoseHack 2023",
    role: "Software Lead",
    desc: "Led software for RoseHack 2023 — introduced the QR check-in system now used across UCR hackathons.",
  },
  {
    event: "CutieHack 2023",
    role: "Software Lead",
    desc: "Led software for CutieHack 2023 — introduced Aurora, the Discord bot, Google Calendar schedules, and slide templates.",
  },
  {
    event: "RoseHack 2024",
    role: "Software Lead",
    desc: "Led software for RoseHack 2024 — introduced Hack Week and federated judging.",
