// Ordered oldest → newest. Same-year tie-break: RoseHack → CitrusHack → CutieHack;
// other same-year events keep their existing relative order.
const judgedProjects = [
  {
    event: "CutieHack 2022",
    role: "Judge",
    desc: "Judged projects at CutieHack 2022.",
  },
  {
    event: "Vikings Hacks 2024",
    role: "Judge",
    desc: "Judged projects at Vikings Hacks 2024.",
  },
  {
    event: "CutieHack 2024",
    role: "Judge",
    desc: "Judged projects at CutieHack 2024.",
  },
  {
    event: "Vikings Hacks 2025",
    role: "Judge",
    desc: "Judged projects at Vikings Hacks 2025.",
  },
  {
    event: "CutieHack 2025",
    role: "Judge",
    desc: "Judged projects at CutieHack 2025.",
  },
  {
    event: "Vikings Hacks 2026",
    role: "Judge",
    desc: "Judged projects at Vikings Hacks 2026.",
  },
  {
    event: "Palo Alto Hacks 2026",
    role: "Judge",
    desc: "Judged projects at Palo Alto Hacks 2026.",
  },
  {
    event: "HackDavis 2026",
    role: "Judge",
    desc: "Judged projects at HackDavis 2026.",
  },
