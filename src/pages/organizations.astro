---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/site/TopBar.astro";
import SectionNav from "../components/site/SectionNav.astro";
import Masthead from "../components/site/Masthead.astro";
import HairlineSection from "../components/site/HairlineSection.astro";
import SectionHeadingRow from "../components/site/SectionHeadingRow.astro";
import Reveal from "../components/site/Reveal.astro";
import GalleryGridPattern from "../components/site/GalleryGridPattern.astro";
import Footer from "../components/site/Footer.astro";

const organizations = [
  {
    org: "Association for Computing Machinery @ University of California, Riverside",
    role: "Projects Director",
    location: "Riverside, CA",
    dates: "Mar 2022 – Jun 2025",
    logo: "ACM @ UCR",
    logoSrc: "/images/logos/acm-ucr-logo.png",
    items: [
      "Initiated 90+ projects (websites, ed-tech for CSE dept, clubs) with 300+ developers",
      "Led 16+ career workshops (resumes, interviews, research, grad studies) +30% retention",
      "Taught 32+ web-dev workshops (React, Next.js, Tailwind, NextAuth)",
    ],
  },
  {
    org: "Association for Computing Machinery @ University of California, Riverside",
    role: "President",
    location: "Riverside, CA",
    dates: "Mar 2023 – Feb 2024",
    logo: "ACM @ UCR",
    logoSrc: "/images/logos/acm-ucr-logo.png",
    items: [
      "Led 9-week intro to embedded systems workshop series covering state machines, Arduino, LEDs, DC motors, IR remotes with custom lab kits",
      "Organized 20+ academic, social, and professional development events with 50+ person attendance",
      "Initiated and developed intern program for underclassmen to learn ACM orchestration and plan Winter 2024 events",
    ],
  },
  {
    org: "Association for Computing Machinery @ University of California, Riverside",
    role: "Project Director",
    location: "Riverside, CA",
    dates: "Mar 2022 – Present",
    logo: "ACM @ UCR",
    logoSrc: "/images/logos/acm-ucr-logo.png",
    items: [
      "Spearheaded 20+ projects including official website, membership portal, coding platform, and org websites, growing developer count to 140+",
      "Created internal tooling including custom GitHub Actions for formatting, linting, and builds plus an image conversion script (png/jpeg/jpg to webp) with automated PRs used by 15+ ACM projects and hackathons (CutieHack, CitrusHack, RoseHack, BearHack, DesignVerse)",
      "Created template org workflows for Next.js deployments on GitHub Pages and static CI (formatting, linting, build) for 10+ projects",
      "Created template Next.js ACM UCR website bundling necessary packages with configured CI for 16+ projects",
      "Led official ACM website, Undecided, BitByBit, Discord bot, and membership portal teams with 2–8 developers per team in AGILE environment",
    ],
  },
  {
    org: "Association for Computing Machinery @ University of California, Riverside",
    role: "Professional Development Chair",
    location: "Riverside, CA",
    dates: "Mar 2022 – Mar 2023",
    logo: "ACM @ UCR",
    logoSrc: "/images/logos/acm-ucr-logo.png",
    items: [
      "Instructed 16+ weekly web development workshops covering React, Next.js, TailwindCSS, and web practices",
      "Headed 8+ weekly career workshops covering resumes, interviews, research, graduate studies, course planning, and internships to increase member retention by 30%",
    ],
  },
  {
    org: "UCR Solar Car",
    role: "Member",
    location: "Riverside, CA",
    dates: "UCR Bourns College of Engineering",
    logo: "UCR Solar Car",
    logoSrc: "/images/logos/ucr-solar-car.png",
    items: [
      "Student engineering team designing and building solar-powered vehicles",
    ],
  },
];

const gallery = [
  { title: "TEAM", caption: "Add photo caption — who is shown here?" },
  { title: "EVENT", caption: "Add photo caption — what event is shown?" },
  { title: "PROJECT", caption: "Add photo caption — what project is shown?" },
  { title: "COMMUNITY", caption: "Add photo caption — what did the community build?" },
];
---
<Layout title="Organizations — Divyank Shah" description="Leadership at ACM UCR.">
  <TopBar showName />
  <Masthead word="ORGANIZATIONS" label="LEADERSHIP" />
  <SectionNav active="Organizations" />
  <main>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Organizations" copy="" /></Reveal>
      <div class="mt-10 space-y-10">
        <Reveal>
          <article class="hairline p-6">
            <div class="flex items-start gap-5">
              <div class="keep-round flex aspect-square h-20 w-20 shrink-0 items-center justify-center overflow-hidden border border-line bg-white">
                <img src="/images/logos/acm-ucr-logo.png" alt="ACM @ UCR" class="keep-round h-full w-full object-cover" loading="lazy" />
              </div>
              <div class="min-w-0 flex-1 space-y-6">
                {organizations
                  .filter((organization) => organization.org !== "UCR Solar Car")
                  .map((organization) => (
                    <div key={organization.role}>
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h3 class="text-lg font-medium">{organization.org} — {organization.role}</h3>
                        <p class="text-xs uppercase tracking-wide text-ink-muted">{organization.location} · {organization.dates}</p>
                      </div>
                      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink-muted">{organization.items.map((item) => <li>{item}</li>)}</ul>
                    </div>
                  ))}
              </div>
            </div>
          </article>
        </Reveal>
        <Reveal delay={0.04}>
          <article class="hairline p-6">
            <div class="flex items-start gap-5">
              <div class="keep-round flex aspect-square h-20 w-20 shrink-0 items-center justify-center overflow-hidden border border-line bg-white">
                <img src="/images/logos/ucr-solar-car.png" alt="UCR Solar Car" class="keep-round h-full w-full object-cover" loading="lazy" />
              </div>
              <div class="min-w-0 flex-1 space-y-6">
                {organizations
                  .filter((organization) => organization.org === "UCR Solar Car")
                  .map((organization) => (
                    <div key={organization.role}>
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h3 class="text-lg font-medium">{organization.org} — {organization.role}</h3>
                        <p class="text-xs uppercase tracking-wide text-ink-muted">{organization.location} · {organization.dates}</p>
                      </div>
                      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink-muted">{organization.items.map((item) => <li>{item}</li>)}</ul>
                    </div>
                  ))}
              </div>
            </div>
          </article>
        </Reveal>
      </div>
    </HairlineSection>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Gallery" copy="Team moments, events, and projects from the organizations I lead." /></Reveal>
      <GalleryGridPattern items={gallery} />
    </HairlineSection>
  </main>
  <Footer />
</Layout>