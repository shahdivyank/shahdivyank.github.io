---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/site/TopBar.astro";
import Masthead from "../components/site/Masthead.astro";
import SectionNav from "../components/site/SectionNav.astro";
import HairlineSection from "../components/site/HairlineSection.astro";
import SectionHeadingRow from "../components/site/SectionHeadingRow.astro";
import Marquee from "../components/site/Marquee.astro";
import Reveal from "../components/site/Reveal.astro";
import GalleryGridPattern from "../components/site/GalleryGridPattern.astro";
import Footer from "../components/site/Footer.astro";

const gallery = [
  { title: "IN THE LAB", caption: "Add photo caption — what are you working on?" },
  { title: "OUTSIDE THE CODE", caption: "Add photo caption — what are you exploring?" },
  { title: "MOMENT", caption: "Add photo caption — what is happening here?" },
];
---
<Layout title="Divyank Shah — Portfolio" description="Divyank Shah: CS @ UC Riverside, full-stack, mobile, ML.">
  <div id="top">
    <TopBar />
    <Masthead word="DIVYANK" side="SHAH" label="PORTFOLIO" />
    <SectionNav active="Home" />
    <main>
      <HairlineSection id="home">
        <Reveal><SectionHeadingRow title="Home" copy="MS / BS in Computer Science @ UC Riverside. I build full-stack, mobile, and ML systems — from TSP transit apps to federated 3D detection." ctaLabel="Experiences" ctaHref="/experiences" /></Reveal>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
          <Reveal>
            <article class="hairline p-6">
              <div class="flex items-start gap-5">
                <div class="keep-round flex aspect-square h-20 w-20 shrink-0 items-center justify-center overflow-hidden border border-line bg-white sm:h-24 sm:w-24">
                  <img src="/images/logos/ucr-logo.png" alt="University of California, Riverside" class="keep-round h-full w-full object-cover" loading="lazy" />
                </div>
                <div class="min-w-0">
                  <p class="text-xs uppercase tracking-wide text-ink-muted">Education</p>
                  <h3 class="mt-2 text-xl font-medium">University of California — Riverside</h3>
                  <p class="mt-1 text-sm text-ink-muted">Riverside, California</p>
                </div>
              </div>
              <ul class="mt-4 space-y-2 text-sm leading-relaxed"><li><strong>MS in Computer Science</strong> — Mar 2024 – Mar 2025</li><li><strong>BS in Computer Science</strong> — Sep 2021 – Mar 2024</li></ul>
            </article>
          </Reveal>
          <Reveal delay={0.08}><article class="hairline p-6"><p class="text-xs uppercase tracking-wide text-ink-muted">Technical Skills</p><ul class="mt-4 space-y-3 text-sm leading-relaxed"><li><strong>Languages:</strong> Python, JavaScript, TypeScript, React, React Native, C++, Go, HTML, CSS, SQL</li><li><strong>Machine Learning:</strong> PyTorch, NumPy, FAISS, Pandas, Flower.ai, TensorFlow</li><li><strong>Developer Tools:</strong> Git, Github, PyTest, Cypress, GCP, Github Actions, Concourse CI, Anaconda</li><li><strong>Technologies:</strong> Next.js, TailwindCSS, Expo, MongoDB, InfluxDB, Grafana</li><li><strong>Management:</strong> Jira, Confluence, SAFe 5, Scrum, Github Projects, Azure DevOps</li></ul></article></Reveal>
        </div>
        <Reveal><div class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-4"><a href="/experiences" class="hairline p-5 hover:bg-ink hover:text-on-ink transition"><p class="text-xs uppercase opacity-70">01</p><p class="mt-1 font-medium">Experiences →</p></a><a href="/research" class="hairline p-5 hover:bg-ink hover:text-on-ink transition"><p class="text-xs uppercase opacity-70">02</p><p class="mt-1 font-medium">Research →</p></a><a href="/projects" class="hairline p-5 hover:bg-ink hover:text-on-ink transition"><p class="text-xs uppercase opacity-70">03</p><p class="mt-1 font-medium">Projects →</p></a><a href="/music" class="hairline p-5 hover:bg-ink hover:text-on-ink transition"><p class="text-xs uppercase opacity-70">04</p><p class="mt-1 font-medium">Music →</p></a><a href="/hackathons" class="hairline p-5 hover:bg-ink hover:text-on-ink transition"><p class="text-xs uppercase opacity-70">05</p><p class="mt-1 font-medium">Hackathons →</p></a><a href="/organizations" class="hairline p-5 hover:bg-ink hover:text-on-ink transition"><p class="text-xs uppercase opacity-70">06</p><p class="mt-1 font-medium">Organizations →</p></a><a href="/teaching" class="hairline p-5 hover:bg-ink hover:text-on-ink transition"><p class="text-xs uppercase opacity-70">07</p><p class="mt-1 font-medium">Teaching →</p></a></div></Reveal>
        <Reveal><div class="mt-10"><p class="text-xs uppercase tracking-wide text-ink-muted">A few frames</p><GalleryGridPattern items={gallery} /></div></Reveal>
      </HairlineSection>
      <Marquee items={["Divyank Shah", "Experiences", "Research", "Projects", "Music", "Hackathons", "Organizations", "Teaching"]} />
    </main>
    <Footer />
  </div>
</Layout>
