---
<Layout title="Projects — Divyank Shah" description="52 projects — hackathon platforms, fullstack apps, embedded systems, ML, bots, and dev tooling.">
  <TopBar showName />
  <Masthead word="PROJECTS" label="SELECTED WORK" />
  <SectionNav active="Projects" />
  <main>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Projects" copy="Hackathon winners, social music, and infra powering 70+ devs and 5+ hackathons — searchable and filterable." ctaLabel="GitHub" ctaHref="https://github.com/shahdivyank" ctaIcon /></Reveal>
      <div class="mt-10 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <label class="hairline flex w-full items-center gap-3 px-4 py-3 lg:max-w-md">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0 text-ink-muted">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
          </svg>
          <span class="sr-only">Search projects</span>
          <input id="project-search" type="search" placeholder="Search by name or description…" autocomplete="off" class="w-full bg-transparent text-sm outline-none placeholder:text-ink-muted" />
        </label>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by project type">
          {categories.map((cat) => (
            <button type="button" class="filter-btn border border-line px-3 py-2 text-xs uppercase tracking-wide transition-colors" data-project-filter={cat.id} aria-pressed={cat.id === "all" ? "true" : "false"}>{cat.label}</button>
          ))}
        </div>
      </div>
      <p id="project-count" class="mt-6 text-xs uppercase tracking-wide text-ink-muted" aria-live="polite">Showing {total} of {total} projects</p>
      <div id="project-grid" class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <Reveal>
            <article class="hairline relative flex h-full flex-col p-6" data-project data-categories={project.categories.join(",")} data-search={searchText(project)}>
              <div class="flex min-h-7 items-start justify-between gap-3">
                <p class="text-xs uppercase tracking-wide text-ink-muted">{project.eyebrow}</p>
                <p class="shrink-0 border border-line px-2 py-1 text-[0.65rem] font-medium uppercase tracking-wide">{categoryLabels[project.categories[0]]}</p>
              </div>
              <h3 class="mt-2 text-lg font-medium">{project.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{project.desc}</p>
              {project.bullets && (
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted">
                  {project.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              )}
              <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-4 text-sm">
                <a href={project.href} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 underline">
                  <LinkIcon href={project.href} class="h-4 w-4" />
                  {project.linkLabel ?? "View repo ↗"}
                </a>
                {project.secondaryHref && (
                  <a href={project.secondaryHref} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-ink-muted underline">
                    <LinkIcon href={project.secondaryHref} class="h-4 w-4" />
                    {project.secondaryLabel}
                  </a>
                )}
              </div>
            </article>
          </Reveal>
        ))}
      </div>
      <p id="projects-empty" class="hairline mt-10 p-10 text-center text-sm text-ink-muted" hidden>No projects match your search or filter.</p>
    </HairlineSection>
  </main>
  <Footer />
</Layout>
<script>
  function initProjectFilters() {
    const grid = document.getElementById("project-grid");
    if (!grid || grid.getAttribute("data-filter-init") === "true") return;
    grid.setAttribute("data-filter-init", "true");
    const searchInput = document.getElementById("project-search");
    const countEl = document.getElementById("project-count");
    const emptyEl = document.getElementById("projects-empty");
    if (!(searchInput instanceof HTMLInputElement) || !countEl || !emptyEl) return;
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"),
    );
    const items = Array.from(grid.querySelectorAll<HTMLElement>("[data-project]"));
    let activeFilter = "all";

    function applyFilters() {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;
      for (const item of items) {
        const itemCategories = (item.dataset.categories || "").split(",");
        const matchesFilter = activeFilter === "all" || itemCategories.includes(activeFilter);
        const matchesQuery = !query || (item.dataset.search || "").includes(query);
        const show = matchesFilter && matchesQuery;
        const wrapper = item.closest("[data-reveal]");
        if (wrapper instanceof HTMLElement) wrapper.hidden = !show;
        if (show) visible += 1;
      }
      countEl.textContent = `Showing ${visible} of ${items.length} projects`;
      emptyEl.hidden = visible !== 0;
    }

    searchInput.addEventListener("input", applyFilters);
    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        activeFilter = btn.getAttribute("data-project-filter") || "all";
        for (const other of buttons) {
          other.setAttribute("aria-pressed", other === btn ? "true" : "false");
        }
        applyFilters();
      });
    }
    applyFilters();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectFilters);
  } else {
    initProjectFilters();
  }
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
<style>
  .filter-btn[aria-pressed="true"] {
    background: var(--ink);
    color: var(--on-ink);
  }
</style>
