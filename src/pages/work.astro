---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/site/TopBar.astro";
import SectionNav from "../components/site/SectionNav.astro";
import Masthead from "../components/site/Masthead.astro";
import HairlineSection from "../components/site/HairlineSection.astro";
import SectionHeadingRow from "../components/site/SectionHeadingRow.astro";
import ProjectCard from "../components/site/ProjectCard.astro";
import Collage from "../components/site/Collage.astro";
import Footer from "../components/site/Footer.astro";
---
<Layout title="Work — Divyank Shah" description="Projects and case studies.">
  <TopBar showName />
  <Masthead word="WORK" label="PROJECTS" />
  <SectionNav active="Work" />
  <main>
    <HairlineSection>
      <SectionHeadingRow titleA="All" titleB="Projects" copy="Every project framed like an upcoming-events card: image, eyebrow, title, muted description." ctaLabel="Contact" ctaHref="/about#contact" />
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        <ProjectCard title="[Project title]" desc="Scope + outcome in one line." imageSrc="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80&auto=format&fit=crop" />
        <ProjectCard title="[Project title]" desc="Scope + outcome in one line." imageSrc="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&q=80&auto=format&fit=crop" />
        <ProjectCard title="[Project title]" desc="Scope + outcome in one line." imageSrc="https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=800&q=80&auto=format&fit=crop" />
        <ProjectCard title="[Project title]" desc="Scope + outcome in one line." imageSrc="https://images.unsplash.com/photo-1522542550221-31fd19575a2d?w=800&q=80&auto=format&fit=crop" />
        <ProjectCard title="[Project title]" desc="Scope + outcome in one line." imageSrc="https://images.unsplash.com/photo-1545235617-9465d2a55698?w=800&q=80&auto=format&fit=crop" />
        <ProjectCard title="[Project title]" desc="Scope + outcome in one line." imageSrc="https://images.unsplash.com/photo-1581291518857-4e27b48ff24e?w=800&q=80&auto=format&fit=crop" />
      </div>
    </HairlineSection>
    <HairlineSection>
      <SectionHeadingRow titleA="Featured" titleB="Spread" copy="Asymmetric collage for hero case studies." ctaLabel="Home" ctaHref="/" />
      <div class="mt-10"><Collage /></div>
    </HairlineSection>
  </main>
  <Footer />
</Layout>