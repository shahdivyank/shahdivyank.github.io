---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/site/TopBar.astro";
import SectionNav from "../components/site/SectionNav.astro";
import Masthead from "../components/site/Masthead.astro";
import HairlineSection from "../components/site/HairlineSection.astro";
import SectionHeadingRow from "../components/site/SectionHeadingRow.astro";
import Reveal from "../components/site/Reveal.astro";
import GalleryGridPattern from "../components/site/GalleryGridPattern.astro";
import LinkIcon from "../components/site/LinkIcon.astro";
import Footer from "../components/site/Footer.astro";

type Workshop = {
  org: string;
  title: string;
  location: string;
  desc: string;
};

const workshops: Workshop[] = [
  {
    org: "Marketing Student Association",
    title: "Data Analytics in Sales and Marketing",
    location: "San Jose State University",
    desc: "Workshop on putting data analytics to work across sales and marketing — from raw numbers to decisions.",
  },
  {
    org: "Management Information Systems Association",
    title: "Breaking into Big Tech",
    location: "San Jose State University",
    desc: "Workshop on breaking into big tech — the skills, portfolio, and interview prep that get you there.",
  },
];

// Small gallery for the teaching page — drop in a photo by adding `src` / `alt` to an item.
const workshopGallery = [
  {
    title: "MSA WORKSHOP",
    src: "/images/teaching/marketing-association-0.webp",
    alt: "Students and presenters gathered for a group photo after the Data Analytics in Sales and Marketing workshop at San Jose State University",
    width: 4032,
    height: 3024,
  },
  {
    title: "WORKSHOP ACTIVITY",
    src: "/images/teaching/marketing-association-1.webp",
    alt: "Panelists answering questions at the Data Analytics in Sales and Marketing workshop, projected slide reading Activity",
    width: 5184,
    height: 3456,
  },
  {
    title: "MISA WORKSHOP",
    src: "/images/teaching/management-information-0.webp",
    alt: "Management Information Systems Association Breaking into Big Tech workshop at San Jose State University",
  },
  {
    title: "IN THE CLASSROOM",
    src: "/images/teaching/management-information-1.webp",
    alt: "Classroom session at the Management Information Systems Association Breaking into Big Tech workshop at San Jose State University",
  },
];
---
<Layout title="Teaching — Divyank Shah" description="TA and K-12 mentorship.">
  <TopBar showName />
  <Masthead word="TEACHING" label="MENTORSHIP" />
  <SectionNav active="Teaching" />
  <main>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Teaching" copy="800+ university students + 200+ K-12 learners across camps and robotics." /></Reveal>
      <div class="mt-10 space-y-6">
        <Reveal><article class="hairline h-full p-6 flex flex-col"><div class="flex items-start gap-5"><div class="keep-round flex aspect-square h-20 w-20 shrink-0 items-center justify-center overflow-hidden border border-line bg-white"><img src="/images/logos/ucr-logo.webp" alt="UC Riverside" class="keep-round h-full w-full object-cover" loading="lazy" /></div><div class="min-w-0 flex-1"><div class="flex flex-wrap items-baseline justify-between gap-2"><h3 class="text-lg font-medium">UC Riverside — Data Structures & Algorithms TA (Prof. Patrick Miller)</h3><p class="text-xs uppercase tracking-wide text-ink-muted">Spring 2024 · Fall 2024 · Winter 2025 · Spring 2025</p></div><ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted"><li>800+ students: lists, stacks, queues, trees, heaps, hashtables, graphs</li><li>Whiteboard demos, weekly office hours, 49× 1hr quiz reviews, 11× 3hr final reviews</li><li>Graded quizzes, finals, programming/labs for code quality</li></ul></div></div></article></Reveal>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3 [grid-auto-rows:1fr]">
          <Reveal><article class="hairline h-full p-6 flex flex-col"><div class="keep-round flex aspect-square h-16 w-16 items-center justify-center overflow-hidden border border-line bg-white"><img src="/images/logos/code-ninjas-logo.webp" alt="Code Ninjas" class="keep-round h-full w-full object-cover" loading="lazy" /></div><h3 class="mt-4 font-medium">Code Ninjas — Code Sensei #2</h3><p class="text-xs uppercase text-ink-muted">Fremont, CA · Jun–Sep 2021</p><ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted"><li>Roblox, Minecraft mods, 3D printing, Python/Scratch camps</li><li>30+ students; 50+ JS practice sets; 0→200 followers, 8K likes</li></ul><a href="https://www.tiktok.com/@codeninjasfremonthub" target="_blank" rel="noreferrer" class="mt-3 inline-flex items-center gap-1.5 text-sm underline"><LinkIcon href="https://www.tiktok.com/@codeninjasfremonthub" class="h-4 w-4" />TikTok ↗</a></article></Reveal>
          <Reveal delay={0.06}><article class="hairline h-full p-6 flex flex-col"><div class="keep-round flex aspect-square h-16 w-16 items-center justify-center overflow-hidden border border-line bg-white"><img src="/images/logos/cra-logo.webp" alt="California Robotics Academy" class="keep-round h-full w-full object-cover" loading="lazy" /></div><h3 class="mt-4 font-medium">California Robotics Academy — Founder</h3><p class="text-xs uppercase text-ink-muted">Fremont, CA · Aug 2019 – Sep 2021</p><ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted"><li>12+ Python/Java/Arduino curriculums, 20+ instructors trained</li><li>28+ weekly camps, 200+ students, 65+ reviews, $600+ charity</li></ul></article></Reveal>
          <Reveal delay={0.12}><article class="hairline h-full p-6 flex flex-col"><div class="keep-round flex aspect-square h-16 w-16 items-center justify-center overflow-hidden border border-line bg-white"><img src="/images/logos/fll-logo.webp" alt="FIRST LEGO League" class="keep-round h-full w-full object-cover" loading="lazy" /></div><h3 class="mt-4 font-medium">FLL Robotics — Student Coach</h3><p class="text-xs uppercase text-ink-muted">Teams 46674 / 45077 · 2019–2021</p><ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted"><li>LEGO mechanisms, sensors, odometry; 12+ Scratch workshops</li><li>2 outreach events; mentored 15+ middle schoolers</li></ul></article></Reveal>
        </div>
      </div>
    </HairlineSection>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Workshops" copy="SJSU student-association workshops — analytics for marketers and a playbook for breaking into big tech." /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        {workshops.map((workshop, i) => (
          <Reveal delay={i * 0.06}>
            <article class="hairline h-full p-6 flex flex-col">
              <p class="text-xs uppercase tracking-wide text-ink-muted">{workshop.org} · {workshop.location}</p>
              <h3 class="mt-2 text-lg font-medium">{workshop.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{workshop.desc}</p>
            </article>
          </Reveal>
        ))}
      </div>
    </HairlineSection>
    <HairlineSection>
      <Reveal><SectionHeadingRow title="Gallery" copy="Photos from the workshops, lectures, and mentoring sessions." /></Reveal>
      <Reveal delay={0.04}>
        <div class="mt-10">
          <GalleryGridPattern items={workshopGallery} />
        </div>
      </Reveal>
    </HairlineSection>
  </main>
  <Footer />
</Layout>