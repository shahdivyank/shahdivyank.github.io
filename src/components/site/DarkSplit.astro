---
interface Props {
  vertical?: string;
  quote?: string;
  giant?: string;
  imageSrc?: string;
  imageAlt?: string;
}
const {
  vertical = "Writing",
  quote = "Notes on building interfaces with type, grid, and restraint.",
  giant = "NOTES",
  imageSrc = "https://images.unsplash.com/photo-1519683109079-d5f539e1542f?w=1000&q=80&auto=format&fit=crop",
  imageAlt = "Abstract editorial image",
} = Astro.props;
---
<section class="relative w-full overflow-hidden bg-ink text-on-ink">
  <div class="gutter grid grid-cols-4 gap-8 py-16 md:py-24 lg:grid-cols-12">
    <div class="col-span-1 hidden sm:flex items-start justify-center">
      <span class="vertical-word text-xs uppercase tracking-[0.3em] text-on-ink/70">{vertical}</span>
    </div>
    <div class="col-span-4 sm:col-span-3 lg:col-span-5 flex flex-col justify-center gap-6">
      <p class="max-w-[32ch] text-xl leading-relaxed md:text-2xl">{quote}</p>
      <a href="/writing" aria-label="Go to writing" class="flex h-12 w-12 items-center justify-center rounded-full border border-on-ink/60 transition hover:bg-on-ink hover:text-ink" style="border-radius:9999px">↗</a>
    </div>
    <div class="col-span-4 lg:col-span-6 relative min-h-70">
      <div class="absolute inset-0 overflow-hidden" style="clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%)">
        <img src={imageSrc} alt={imageAlt} class="h-full w-full object-cover" loading="lazy" />
      </div>
    </div>
  </div>
  <div class="gutter overflow-hidden pb-4">
    <p aria-hidden="true" class="m-0 select-none text-[clamp(3rem,12vw,10rem)] font-medium uppercase leading-[0.85] tracking-[-0.04em] text-on-ink">{giant}</p>
  </div>
</section>