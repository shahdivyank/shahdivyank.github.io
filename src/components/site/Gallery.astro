---
import MediaPlaceholder from "./MediaPlaceholder.astro";

type GalleryItem = {
  src?: string;
  alt?: string;
  title: string;
  caption?: string;
  width?: number;
  height?: number;
  ratio?: "landscape" | "square" | "portrait";
};

interface Props {
  items: GalleryItem[];
  layout?: "grid" | "masonry";
}

const { items, layout = "grid" } = Astro.props;

const matchingHeight = (title: string) => title === "JUDGING" || title === "PARTICIPATING";
---

<div
  class:list={[
    "m-0",
    layout === "masonry"
      ? [
          "masonry",
          "column-count-1",
          "column-gap-2",
          "md:column-count-2",
          "lg:column-count-3",
          "xl:column-count-4",
        ]
      : "grid grid-cols-1 gap-x-2 gap-y-4 md:grid-cols-12",
  ]}
>
  {items.map((item) => {
    const isMatching = matchingHeight(item.title);
    const figureClasses = [
      "m-0 break-inside-avoid",
      layout === "masonry"
        ? [
            item.title === "JUDGING" ? "md:col-span-7" : item.title === "PARTICIPATING" ? "md:col-span-5" : "md:col-span-4",
            item.ratio === "square" && "md:col-span-5",
            item.ratio === "landscape" && "md:col-span-7",
            isMatching && "md:aspect-7/3",
          ]
        : [],
    ].flat();

    return (
      <figure class:list={figureClasses}>
        {item.src ? (
          <img
            src={item.src}
            alt={item.alt ?? ""}
            width={item.width}
            height={item.height}
            class:list={[
              "block w-full border border-line",
              isMatching ? "h-full object-cover" : "h-auto",
            ]}
            loading="lazy"
          />
        ) : (
          <MediaPlaceholder label={item.title} ratio={isMatching ? "landscape" : item.ratio ?? "landscape"} />
        )}
        <figcaption class="mt-2">
          <p class="text-xs uppercase tracking-wide">{item.title}</p>
          {item.caption && <p class="text-sm italic text-ink-muted">{item.caption}</p>}
        </figcaption>
      </figure>
    );
  })}
</div>

<style>
  .masonry {
    column-count: 1;
    column-gap: 0.5rem;
    column-fill: auto;
  }

  .masonry img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 768px) {
    .masonry.column-count-1 {
      column-count: 1;
    }
  }

  @media (min-width: 1024px) {
    .masonry.column-count-2 {
      column-count: 2;
    }
  }

  @media (min-width: 1280px) {
    .masonry.column-count-3 {
      column-count: 3;
    }
  }

  @media (min-width: 1536px) {
    .masonry.column-count-4 {
      column-count: 4;
    }
  }
</style>
