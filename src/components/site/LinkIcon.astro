---
interface Props {
  href?: string;
  class?: string;
}
const { href = "", class: cls = "h-4 w-4" } = Astro.props;

const isExternal = /^https?:\/\//i.test(href);
let host = "";
if (isExternal) {
  try {
    host = new URL(href).hostname.replace(/^www\./, "");
  } catch {
    host = "";
  }
}

type LinkKind = "github" | "devpost" | "apple" | "linkedin" | "tiktok" | "guide" | "external" | "internal";
let kind: LinkKind = "external";
if (!isExternal) kind = "internal";
else if (host === "github.com") kind = "github";
else if (host === "devpost.com") kind = "devpost";
else if (host === "apple.com" || host.endsWith(".apple.com")) kind = "apple";
else if (host === "linkedin.com" || host.endsWith(".linkedin.com") || host === "lnkd.in") kind = "linkedin";
else if (host === "tiktok.com" || host.endsWith(".tiktok.com")) kind = "tiktok";
else if (host === "instructables.com") kind = "guide";
