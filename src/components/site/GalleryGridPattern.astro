---
import MediaPlaceholder from "./MediaPlaceholder.astro";

type GalleryItem = {
  src?: string;
  alt?: string;
  title: string;
  caption?: string;
  width?: number;
  height?: number;
  ratio?: "landscape" | "square" | "portrait";
};

interface Props {
  items: GalleryItem[];
  columns?: 3 | 4;
}

const { items = [], columns = 3 } = Astro.props;
---

<div class={`grid grid-cols-1 gap-6 md:grid-cols-${columns} md:gap-8`}>
  {items.map((item, index) => (
    <figure
      class:list={[
        "m-0 break-inside-avoid",
        columns === 4 && index === 0 ? "md:col-span-4" : null,
        columns === 4 && index !== 0 ? "md:col-span-2" : null,
      ]}
    >
      {item.src ? (
        <img
          src={item.src}
          alt={item.alt ?? ""}
          width={item.width}
          height={item.height}
          class="block aspect-square w-full border border-line object-cover"
          loading="lazy"
        />
      ) : (
        <MediaPlaceholder label={item.title} ratio="square" />
      )}
      <figcaption class="mt-2">
        <p class="text-xs uppercase tracking-wide">{item.title}</p>
        {item.caption && <p class="text-sm italic text-ink-muted">{item.caption}</p>}
      </figcaption>
    </figure>
  ))}
</div>

