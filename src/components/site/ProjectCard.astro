---
interface Props {
  eyebrow?: string;
  title?: string;
  desc?: string;
  imageSrc?: string;
  imageAlt?: string;
  href?: string;
}
const { eyebrow="Project", title="[Project title]", desc="Short muted description — replace with real copy.", imageSrc="https://images.unsplash.com/photo-1524578271613-d550eacf6090?w=800&q=80&auto=format&fit=crop", imageAlt="", href="/work" } = Astro.props;
---
<a href={href} class="group block border border-line">
  <div class="card-frame aspect-16/10 border-b border-line">
    <img src={imageSrc} alt={imageAlt || title} class="h-full w-full object-cover" loading="lazy" />
  </div>
  <div class="p-5">
    <p class="text-xs uppercase tracking-wide text-ink-muted">{eyebrow}</p>
    <h3 class="mt-2 flex items-center justify-between text-xl font-medium">{title}<span aria-hidden="true" class="opacity-0 transition group-hover:opacity-100">↗</span></h3>
    <p class="mt-2 text-[1rem] leading-[1.7] text-ink-muted">{desc}</p>
  </div>
</a>